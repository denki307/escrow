{
  "name": "telegram-escrow-bot",
  "description": "A semi-automated Telegram escrow bot with Pyrogram and Pyromod",
  "repository": "https://github.com/your-username/your-repo-name",
  "keywords": [
    "python",
    "telegram",
    "bot",
    "escrow",
    "pyrogram"
  ],
  "stack": "container",
  "env": {
    "API_ID": {
      "description": "Your Telegram API ID from my.telegram.org",
      "value": ""
    },
    "API_HASH": {
      "description": "Your Telegram API Hash from my.telegram.org",
      "value": ""
    },
    "BOT_TOKEN": {
      "description": "Your Telegram Bot Token from @BotFather",
      "value": ""
    },
    "OWNER_ID": {
      "description": "Your main Telegram User ID",
      "value": ""
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}

